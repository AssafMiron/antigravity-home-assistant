#!/usr/bin/env bash
# ==============================================================================
# Antigravity Terminal Entrypoint
# Launched by ttyd when a user opens the Home Assistant sidebar panel.
# ==============================================================================

if [ -f /etc/profile.d/antigravity-ha.sh ]; then
    # shellcheck disable=SC1091
    source /etc/profile.d/antigravity-ha.sh
fi

WORK_DIR="${AGY_WORK_DIR:-/homeassistant}"
[ ! -d "${WORK_DIR}" ] && [ -d /config ] && WORK_DIR="/config"
cd "${WORK_DIR}" 2>/dev/null || cd /homeassistant 2>/dev/null || cd /config || true

# If tmux is enabled and we are not already inside tmux, attach or create session
if [ "${AGY_USE_TMUX}" = "true" ] && [ -z "${TMUX}" ]; then
    exec tmux new-session -A -s antigravity "/usr/local/bin/agy-entrypoint --inner"
fi

clear
echo -e "\033[1;34m====================================================================\033[0m"
echo -e "\033[1;36m  🚀 Google Antigravity Terminal for Home Assistant\033[0m"
echo -e "\033[1;34m====================================================================\033[0m"
echo -e "  • \033[1mWorking Directory:\033[0m $(pwd)"
echo -e "  • \033[1mHA Harness:\033[0m        Active (~/.gemini/config/)"
echo -e "  • \033[1mHA Helper CLI:\033[0m     \033[32mha\033[0m (Supervisor CLI) & \033[32mha-api\033[0m (REST API)"
echo -e "  • \033[1mYAML Backups:\033[0m      /data/backups/"
echo -e "\033[1;34m--------------------------------------------------------------------\033[0m"
echo -e "  💡 \033[1mTips:\033[0m"
echo -e "     - On first run, follow the prompt to sign in with your Google AI plan."
echo -e "     - Press \033[1;33mShift + Tab\033[0m inside Antigravity to switch execution modes."
echo -e "     - Type \033[1;32magy\033[0m at any time to start or resume Antigravity."
echo -e "\033[1;34m====================================================================\033[0m"
echo ""

if [ "${AGY_AUTO_LAUNCH}" = "true" ]; then
    if command -v agy >/dev/null 2>&1; then
        echo -e "\033[1;32mStarting Antigravity CLI (agy)...\033[0m"
        echo ""
        agy || true
    else
        echo -e "\033[1;33m⚠️  Antigravity CLI ('agy') binary was not found in PATH.\033[0m"
        echo -e "Run the following command to install it now:"
        echo -e "  \033[1;36mcurl -fsSL https://antigravity.google/cli/install.sh | bash\033[0m"
        echo ""
    fi
fi

# Drop into an interactive bash shell if agy exits or auto_launch is false
exec /bin/bash -l
