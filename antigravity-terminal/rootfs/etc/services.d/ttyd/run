#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Antigravity Terminal
# Runs the ttyd web terminal server on Ingress port 7681
# ==============================================================================

bashio::log.info "Starting Antigravity Web Terminal (ttyd) on port 7681..."

# Source environment variables
if [ -f /etc/profile.d/antigravity-ha.sh ]; then
    # shellcheck disable=SC1091
    source /etc/profile.d/antigravity-ha.sh
fi

WORK_DIR=$(bashio::config 'working_directory')
if [ -d "/homeassistant" ] && { [ ! -d "${WORK_DIR}" ] || { [ "${WORK_DIR}" = "/config" ] && [ ! -f "/config/configuration.yaml" ]; }; }; then
    WORK_DIR="/homeassistant"
elif [ ! -d "${WORK_DIR}" ]; then
    WORK_DIR="/config"
fi

# Start background watcher to deliver OAuth login URL as a clickable HA notification
if [ -z "${GEMINI_API_KEY:-}" ] && [ -x /usr/local/bin/login-url-watcher ]; then
    bashio::log.info "Starting OAuth login URL notification watcher in background..."
    (/usr/local/bin/login-url-watcher >/dev/null 2>&1 || true) &
fi

# Register custom Antigravity sidebar icon in Home Assistant frontend
if [ -x /usr/local/bin/register-ha-sidebar-icon ]; then
    (/usr/local/bin/register-ha-sidebar-icon >/dev/null 2>&1 || true) &
fi

# Ensure enhanced ttyd index.html (multi-line OAuth URL link provider & OSC 52 clipboard) exists
if [ ! -s /usr/share/ttyd/index.html ] && [ -x /usr/local/bin/prepare-ttyd-ui ]; then
    /usr/local/bin/prepare-ttyd-ui || bashio::log.warning "Fallback to built-in ttyd UI."
fi

INDEX_ARGS=()
if [ -s /usr/share/ttyd/index.html ]; then
    INDEX_ARGS=(--index /usr/share/ttyd/index.html)
fi

exec ttyd \
    --port 7681 \
    --interface 0.0.0.0 \
    --writable \
    --cwd "${WORK_DIR}" \
    "${INDEX_ARGS[@]}" \
    -t fontSize=14 \
    -t fontFamily="Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace" \
    -t macOptionClickForcesSelection=true \
    -t theme='{"background":"#0f1419","foreground":"#e6edf3","cursor":"#58a6ff","selectionBackground":"#264f78"}' \
    /usr/local/bin/agy-entrypoint
